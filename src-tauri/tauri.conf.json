{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Image Library",
  "version": "0.1.0",
  "identifier": "dev.devmindtan.image-library",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Thư viện ảnh · AI Organizer",
        "width": 1200,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../backend/": "backend/"
    },
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
